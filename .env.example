# ─────────────────────────────────────────────────────────────
# All of these are OPTIONAL. The site runs fully without them —
# every integration degrades to a documented fallback instead of
# breaking. Fill them in to go live.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Live booking link ────────────────────────────────────────
# Paste a scheduling URL and every "Let's Get in Touch" control
# becomes a real booking link. Leave it empty and those controls
# open an email instead — the site is never broken either way.
#   Cal.com   https://cal.com/<handle>/30min      (free tier)
#   Calendly  https://calendly.com/<handle>/30min (free tier)
#   Google    https://calendar.app.google/<id>    (free)
# You can also hard-code it in src/data/site.ts -> bookingUrl.
NEXT_PUBLIC_BOOKING_URL=""

# ── GitHub ───────────────────────────────────────────────────
# Without a token: public REST API only (rate-limited to 60 req/hr
# per IP) and the contribution calendar is derived from public events.
# With a classic PAT (no scopes needed for public data): exact
# contribution calendar via GraphQL + 5000 req/hr.
GITHUB_USERNAME="rishabh7431"
GITHUB_TOKEN=""

# ── Page-view counter storage ────────────────────────────────
# Leave blank for local SQLite (data/site.db, created automatically,
# needs Node 22.5+). On serverless hosts the filesystem is ephemeral —
# point these at an Upstash Redis database and the store switches over.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Override the SQLite file location, or set DISABLE_SQLITE=1 to force memory.
SQLITE_PATH=""
